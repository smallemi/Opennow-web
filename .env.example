# Public origin used for WebSocket origin checks in production.
OPENNOW_ORIGIN=https://opennow.example.com
# At least 32 random characters. All server instances must use the same value.
SESSION_SECRET=replace-with-a-long-random-production-secret
PORT=3000
# Optional: make this a private instance. When set, visitors must enter this
# password before they can use the app. Leave empty for a public instance.
OPENNOW_INSTANCE_PASSWORD=
# How many days a "Remember this device" unlock stays valid (default 30).
OPENNOW_INSTANCE_REMEMBER_DAYS=30
# Optional: text shown in the browser tab (default "OpenNOW").
OPENNOW_SITE_TITLE=
# Optional: tab icon. A full http(s) link (e.g. https://example.com/icon.png)
# or a path served by this site (e.g. /my-icon.png from the public/ folder).
OPENNOW_FAVICON_URL=
# Optional: strip queue ads from NVIDIA's session responses (free tier), like the
# uBlock rule json-prune-fetch-response for session.sessionAds. Off by default.
# Use at your own risk: NVIDIA may stall or drop the queue if it enforces ads.
OPENNOW_BLOCK_QUEUE_ADS=false
# Optional proxy mode: relay game streams through this server (TURN over TCP) for
# visitors whose network blocks direct WebRTC. off (default) | optional (visitors
# can turn it on in Settings > Stream) | always (every stream is relayed).
OPENNOW_RELAY=off
# Hostname browsers use for TURN. Behind Cloudflare, use a DNS-only (grey cloud)
# record pointing straight at this server, e.g. turn.example.com.
OPENNOW_RELAY_HOST=
# Public TCP port for TURN (not 443 if nginx owns it). Open it in the firewall.
OPENNOW_RELAY_PORT=3478
# Optional: port browsers are told to use, when a firewall redirect or nginx
# stream forwards another port (e.g. 443) to OPENNOW_RELAY_PORT. Default: same.
OPENNOW_RELAY_PUBLIC_PORT=
# Optional: certificate + key to serve TURN over TLS (turns:) on that port.
OPENNOW_RELAY_TLS_CERT=
OPENNOW_RELAY_TLS_KEY=
# Public IPv4 of this server, if it sits behind NAT (auto-detected otherwise).
OPENNOW_RELAY_IP=
# UDP range the relay uses to talk to NVIDIA. Must be open in the firewall.
OPENNOW_RELAY_UDP_PORTS=49152-65535
# Quality limits for relayed streams.
OPENNOW_RELAY_MAX_RESOLUTION=1280x720
OPENNOW_RELAY_MAX_FPS=60
OPENNOW_RELAY_MAX_BITRATE_MBPS=10
