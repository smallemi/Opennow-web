# Public origin used for WebSocket origin checks in production.
OPENNOW_ORIGIN=https://opennow.example.com
# At least 32 random characters. All server instances must use the same value.
SESSION_SECRET=replace-with-a-long-random-production-secret
PORT=3000
# Optional: make this a private instance. When set, visitors must enter this
# password before they can use the app. Leave empty for a public instance.
OPENNOW_INSTANCE_PASSWORD=
# How many days a "Remember this device" unlock stays valid (default 30).
OPENNOW_INSTANCE_REMEMBER_DAYS=30
# Optional: text shown in the browser tab (default "OpenNOW").
OPENNOW_SITE_TITLE=
# Optional: tab icon. A full http(s) link (e.g. https://example.com/icon.png)
# or a path served by this site (e.g. /my-icon.png from the public/ folder).
OPENNOW_FAVICON_URL=
